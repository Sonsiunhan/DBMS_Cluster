[mysqld]
server-id = 1
log-bin = mysql-bin
binlog_format = ROW
binlog-do-db = supermarket_db

# 1. Bật GTID (Global Transaction Identifier)
gtid_mode = ON
enforce_gtid_consistency = ON

# 2. Cấu hình Crash-Safety (Bảo vệ dữ liệu khi mất điện/sự cố)
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1

# 3. Tự động dọn dẹp Log (Tránh tràn ổ cứng)
binlog_expire_logs_seconds = 604800
max_binlog_size = 100M
