[mysqld]
server-id = 2
relay-log = mysql-relay-bin
log-bin = mysql-bin
read_only = 1
super_read_only = 1
replicate-do-db = supermarket_db

# 1. Bật GTID (Global Transaction Identifier)
gtid_mode = ON
enforce_gtid_consistency = ON

# 2. Cấu hình Crash-Safety & Hỗ trợ chuyển đổi Master (Failover)
relay_log_recovery = ON
log_replica_updates = ON
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1

# 3. Tự động dọn dẹp Log (Tránh tràn ổ cứng)
binlog_expire_logs_seconds = 604800
max_binlog_size = 100M
